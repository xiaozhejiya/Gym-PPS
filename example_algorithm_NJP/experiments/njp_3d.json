{
  "description": "独立的三维双方共享 DDPG 策略实验，不代表已复现论文结果。",
  "environment": {
    "dynamics_mode": "Polar", "L": 2, "n_p": 16, "n_e": 160,
    "pursuer_strategy": "input", "escaper_strategy": "input", "is_periodic": true,
    "m_p": 1, "m_e": 1, "size_p": 0.06, "size_e": 0.035,
    "linVel_p_max": 0.5, "linVel_e_max": 0.5,
    "linAcc_p_max": 1, "linAcc_e_max": 1,
    "angle_p_max": 0.05, "angle_e_max": 0.05, "dt": 0.1,
    "k_ball": 50, "k_wall": 100, "c_wall": 5, "c_aero": 2,
    "FoV_p": 5, "FoV_e": 5,
    "topo_n_p2p": 2, "topo_n_p2e": 5, "topo_n_e2p": 2, "topo_n_e2e": 5,
    "penalize_control_effort": false, "penalize_collide_walls": false,
    "penalize_distance": false, "penalize_collide_agents": false,
    "penalize_collide_obstacles": false, "reward_sharing_mode": "individual",
    "render_traj": false, "save_frame": false
  },
  "training": {
    "episodes": 200, "episode_length": 1000, "total_steps": 200000,
    "hidden_dim": 256, "hidden_layers": 3,
    "actor_lr": 0.0001, "critic_lr": 0.001, "gamma": 0.95, "tau": 0.01,
    "buffer_size": 500000, "batch_size": 256, "updates_per_step": 1, "start_steps": 1000,
    "exploration_mode": "paper", "noise": 0.1, "noise_min": 0.05,
    "epsilon": 0.1, "epsilon_min": 0.05, "exploration_decay": 0.00005,
    "fused_adam": true, "cuda_graph": true, "render_interval": 0,
    "checkpoint_interval": 20, "model_path": "ddpg_njp_3d.pt"
  },
  "evaluation": {"episodes": 1, "episode_length": 2000, "gif_stride": 2, "gif_fps": 25},
  "layout": {"observation": "njp3d-v1", "action": "rotation-vector-thrust-v1"}
}
